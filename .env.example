# ==========================================
# CozyMoney 자동 포스팅 환경변수
# ==========================================

# ------------------------------------------
# 실행 모드
# ------------------------------------------

# true  = 테스트만 실행, 실제 게시/배포하지 않음
# false = 실제 게시 및 배포
DRY_RUN=true


# ------------------------------------------
# AI 우선순위
#
# 1. Gemini
# 2. Groq
# 3. OpenRouter
#
# API Key가 없거나
# API 오류 / quota / rate limit 발생 시
# 자동으로 다음 Provider로 넘어감
# ------------------------------------------


# ------------------------------------------
# 1. Gemini
# ------------------------------------------

# OpenRouter API Key
GEMINI_API_KEY=

# 글 생성에 사용할 모델
GEMINI_MODEL=gemini-3.6-flash-lite


# ------------------------------------------
# 2. Groq
# ------------------------------------------

# Groq API Key
GROQ_API_KEY=

# 글 생성에 사용할 모델
GROQ_MODEL=openai/gpt-oss-20b


# ------------------------------------------
# 3. OpenRouter
# ------------------------------------------

# OpenRouter API Key
OPENROUTER_API_KEY=

# 글 생성에 사용할 모델
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=https://cozymoney.kr
OPENROUTER_SITE_NAME=CozyMoney
OPENROUTER_MAX_TOKENS=6000


# ================================
# AI - 사실 검증
# 기본 OFF
# Gemini → Groq → OpenRouter
# ================================
ENABLE_AI_FACT_CHECK=false

# ================================
# 이미지 제공 API - Pexels + Unsplash
# 이미지 생성형 AI를 사용하지 않음
# 기본: 게시글당 Pexels 1개 + Unsplash 1개
# 한쪽 API 실패 시 다른 제공자 2개로 자동 fallback
# ================================
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
IMAGE_CANDIDATE_COUNT=6
IMAGE_MIN_CANDIDATES=4


# ------------------------------------------
# 자동 포스팅
# ------------------------------------------

# 카테고리별 하루 게시글 수
POSTS_PER_CATEGORY=2

# AI가 생성할 후보 주제 수
TOPIC_CANDIDATES_PER_CATEGORY=4


# ------------------------------------------
# 프로젝트 경로
# ------------------------------------------

# 게시글 Markdown
POSTS_DIR=src/data/posts

# 자동화 리포트
REPORTS_DIR=reports/automation

# 로그
LOGS_DIR=logs


# ------------------------------------------
# 사이트
# ------------------------------------------

SITE_URL=https://cozymoney.kr


# ------------------------------------------
# Git / 배포
# ------------------------------------------

# 실제 Git push 사용 여부
GIT_PUSH=false

# Git 브랜치
GIT_BRANCH=main











