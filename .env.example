# ==========================================
# CozyMoney 자동 포스팅 환경변수
# ==========================================

# ------------------------------------------
# 실행 모드
# ------------------------------------------

# true  = 테스트만 실행, 실제 게시/배포하지 않음
# false = 실제 게시 및 배포
DRY_RUN=true


# ------------------------------------------
# AI - OpenRouter
# ------------------------------------------

# OpenRouter API Key
OPENROUTER_API_KEY=sk-or-v1-여기에_OpenRouter_API_Key

# 글 생성에 사용할 모델
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# AI 요청 기본 설정
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=6000


# ------------------------------------------
# 이미지 - Pexels
# ------------------------------------------

# Pexels API Key
PEXELS_API_KEY=여기에_Pexels_API_Key

# 게시글 하나당 최대 이미지 개수
MAX_IMAGES_PER_ARTICLE=2

# 이미지 검색 결과에서 사용할 최대 후보 수
PEXELS_PER_PAGE=40


# ------------------------------------------
# 자동 포스팅
# ------------------------------------------

# 카테고리별 하루 게시글 수
POSTS_PER_CATEGORY=2

# AI가 생성할 후보 주제 수
TOPIC_CANDIDATES_PER_CATEGORY=6


# ------------------------------------------
# 프로젝트 경로
# ------------------------------------------

# 게시글 Markdown
POSTS_DIR=src/data/posts

# 자동화 리포트
REPORTS_DIR=reports/automation

# 로그
LOGS_DIR=logs


# ------------------------------------------
# 사이트
# ------------------------------------------

SITE_URL=https://cozymoney.kr


# ------------------------------------------
# Git / 배포
# ------------------------------------------

# 실제 Git push 사용 여부
GIT_PUSH=false

# Git 브랜치
GIT_BRANCH=main